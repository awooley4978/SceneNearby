{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://scene-nearby-api.fly.dev"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://scene-nearby-api.fly.dev"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6790074748"
      }
    }
  }
}
